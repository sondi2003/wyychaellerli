          }
        }
      }
    },
    "Wird beim Scannen vom Etikett übernommen. Auf 0 stellen heisst „keine Angabe“ – dann wird nichts angezeigt." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taken from the label when you scan. Setting it to 0 means “not specified” – then nothing is shown."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri skeniranju se preuzima sa etikete. Podešavanje na 0 znači „bez podatka“ – tada se ništa ne prikazuje."
          }
        }
      }
    },
    "Wird beim Scannen von der Rückseite gelesen und hilft, den Wein im gemeinsamen Katalog wiederzufinden." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read from the back label when you scan and helps find the wine again in the shared catalog."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čita se pri skeniranju sa zadnje strane i pomaže da se vino pronađe u zajedničkom katalogu."
          }
        }
      }
    },
    "Wird mit Bestand 1 angelegt. Etikett, Notizen und Trinkreife kommen mit." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Added with stock 1. Label, notes and drinking window come along."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pravi se sa zalihom 1. Etiketa, beleške i zrelost za pijenje se prenose."
          }
        }
      }
    },
    "Wird mit dem Wein gespeichert." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved with the wine."
