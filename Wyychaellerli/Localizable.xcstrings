    },
    "Die App folgt der Einstellung von iOS." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app follows the iOS setting."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app suit le réglage d’iOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app segue l’impostazione di iOS."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija prati podešavanje iOS-a."
          }
        }
      }
    },
    "Die App kennt schon viele Weine. Beim Scannen und beim Tippen eines Namens schlägt sie passende Weine aus dem gemeinsamen Katalog vor. Bestätigst du einen, ergänzt sie fehlende Angaben und das Foto. Mit „Neue Weine vorschlagen“ in den Einstellungen hilfst du mit, den Katalog zu erweitern – nur Stammdaten und das Foto der Vorderseite, nie Notizen, Bewertungen oder Bestand." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app already knows many wines. When you scan and when you type a name, it suggests matching wines from the shared catalog. When you confirm one, it fills in missing details and the photo. With “Suggest new wines” in Settings you help expand the catalog – master data and the front photo only, never notes, ratings or stock."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app connaît déjà beaucoup de vins. Lors du scan et quand tu tapes un nom, elle propose des vins correspondants du catalogue commun. Si tu en confirmes un, elle complète les indications manquantes et la photo. Avec « Proposer de nouveaux vins » dans les réglages, tu aides à enrichir le catalogue – uniquement les données de base et la photo du recto, jamais les notes, les évaluations ni le stock."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app conosce già molti vini. Durante la scansione e quando scrivi un nome, propone vini adatti dal catalogo comune. Se ne confermi uno, completa i dati mancanti e la foto. Con «Proponi nuovi vini» nelle impostazioni aiuti ad ampliare il catalogo: solo dati di base e foto del fronte, mai note, valutazioni o giacenza."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija već poznaje mnoga vina. Pri skeniranju i pri kucanju naziva predlaže odgovarajuća vina iz zajedničkog kataloga. Kad jedno potvrdiš, dopunjuje podatke koji nedostaju i fotografiju. Opcijom „Predlaži nova vina“ u podešavanjima pomažeš da se katalog proširi – samo osnovni podaci i fotografija prednje strane, nikad beleške, ocene ni zaliha."
          }
        }
      }
    },
    "Die bisherigen Stimmen gehen verloren." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The votes so far will be lost."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les voix exprimées jusqu’ici seront perdues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I voti espressi finora andranno persi."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosadašnji glasovi se gube."
          }
        }
      }
    },
    "Die Einführung sind die Seiten vom ersten Start. Die Tipps sind die kleinen Hinweise am Ort – im Regal, beim Scannen, an der Liste –, die nach dem ersten Mal verschwinden." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The introduction is the pages from the first start. The tips are the small hints in context – in the rack, when scanning, on the list – that disappear after the first time."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’introduction, ce sont les pages du premier démarrage. Les astuces sont les petits conseils sur place – dans le casier, au scan, sur la liste – qui disparaissent après la première fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’introduzione sono le pagine del primo avvio. I suggerimenti sono i piccoli consigli sul posto (nello scaffale, durante la scansione, nell’elenco) che scompaiono dopo la prima volta."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvod su stranice sa prvog pokretanja. Saveti su male napomene na licu mesta – na stalku, pri skeniranju, na listi – koje nestaju nakon prvog puta."
          }
        }
      }
    },
    "Die Einreicher bekommen über den Entscheid eine Mitteilung." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contributors get a notification about the decision."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceux qui ont proposé un vin reçoivent une notification sur la décision."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi ha proposto riceve una notifica sulla decisione."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pošiljaoci dobijaju obaveštenje o odluci."
          }
        }
      }
    },
    "Die Flasche einfach ganz fotografieren" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
