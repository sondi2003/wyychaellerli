    "Die Antwort des Servers war nicht lesbar. Läuft der Ablauf „Webhook Quellensuche“ in n8n, und ist er aktiv?" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server’s reply was not readable. Is the “Webhook Quellensuche” flow in n8n running and active?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réponse du serveur était illisible. Le flux « Webhook Quellensuche » tourne-t-il dans n8n, et est-il actif ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
