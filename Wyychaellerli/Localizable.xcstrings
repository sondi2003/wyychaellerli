    "Auf den Fotos wurde kein Text erkannt. Bitte das Etikett näher und bei gutem Licht fotografieren." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No text was recognized in the photos. Please photograph the label closer and in good light."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun texte n’a été reconnu sur les photos. Photographie l’étiquette de plus près et avec une bonne lumière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelle foto non è stato riconosciuto alcun testo. Fotografa l’etichetta più da vicino e con una buona luce."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na fotografijama nije prepoznat nijedan tekst. Fotografiši etiketu izbliza i na dobrom svetlu."
          }
        }
