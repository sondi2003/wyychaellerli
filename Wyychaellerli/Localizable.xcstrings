        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najmanje dve flaše, inače nema šta da se bira."
          }
        }
      }
    },
    "Mit diesen Angaben steht schon „%@“ im Katalog. Ändere Name, Produzent oder Jahrgang, oder lösche einen der beiden Einträge." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is already in the catalog with these details. Change the name, producer or vintage, or delete one of the two entries."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa ovim podacima „%@“ je već u katalogu. Promeni naziv, proizvođača ili berbu, ili obriši jedan od dva unosa."
          }
        }
      }
