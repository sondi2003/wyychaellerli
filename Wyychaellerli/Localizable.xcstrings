        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čuva se uz vino."
          }
        }
      }
    },
    "Wisch nach links" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
