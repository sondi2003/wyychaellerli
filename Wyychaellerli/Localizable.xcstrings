            "value" : "Preuzmi"
          }
        }
      }
    },
    "Übernommen wird ins Formular. Gespeichert wird erst mit „Aufnehmen“." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Values are taken into the form. Nothing is saved until you tap “Accept”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les valeurs sont reprises dans le formulaire. Rien n’est enregistré avant « Accepter »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I valori vengono portati nel modulo. Si salva solo con «Accetta»."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrednosti se preuzimaju u obrazac. Čuva se tek sa „Prihvati“."
          }
        }
      }
    },
    "Überschreibt auch Angaben, die du schon hast. Name, Produzent und Jahrgang bestimmen den Schlüssel des Eintrags." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Also overwrites details you already have. Name, producer and vintage determine the entry’s key."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplace aussi les indications que tu as déjà. Le nom, le producteur et le millésime déterminent la clé de l’entrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovrascrive anche i dati che hai già. Nome, produttore e annata determinano la chiave della voce."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepisuje i podatke koje već imaš. Naziv, proizvođač i berba određuju ključ unosa."
          }
        }
      }
    },
