    "Bitte weitergeben an": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Molim te, prosledi"
          }
        }
      }
    },
    "Bucht eine Flasche ab. Liegt sie im Regal, fragt die App, aus welchem Fach. Bei der letzten Flasche fragt sie, ob der Wein ins Archiv soll.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Skida jednu flašu sa zalihe. Ako leži na stalku, aplikacija pita iz kog mesta. Kod poslednje flaše pita da li vino ide u arhivu."
          }
        }
      }
    },
    "Chile": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Čile"
          }
        }
      }
    },
    "Dahinter liegt die Rückseite mit Terroir, Ausbau und Speiseempfehlung.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Iza toga je zadnja strana sa terroirom, odležavanjem i preporukom za jela."
          }
        }
      }
    },
    "Darstellung": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgled"
          }
        }
      }
    },
    "Das Ergebnis wird in der Historie gesichert. Danach kannst du die Flasche wie gewohnt öffnen – die App zeigt dir das Regalfach.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezultat se čuva u istoriji. Zatim flašu možeš otvoriti kao i obično – aplikacija ti pokazuje mesto na stalku."
          }
        }
      }
    },
    "Das Guthaben bei %@ ist aufgebraucht oder das Kontingent erschöpft.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit kod provajdera %@ je potrošen ili je kvota iscrpljena."
          }
        }
      }
    },
    "Das Land macht die Karte auf der Detailseite eindeutig.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Zemlja čini mapu na stranici sa detaljima jednoznačnom."
          }
        }
      }
    },
    "Das Regal ist leer und wird einfach entfernt.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Stalak je prazan i jednostavno se uklanja."
          }
        }
      }
    },
    "Das Regal ist voll.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Stalak je pun."
          }
        }
      }
    },
    "Das hat gerade nicht geklappt. Versuch es in der App noch einmal.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo trenutno nije uspelo. Pokušaj ponovo u aplikaciji."
          }
        }
      }
    },
    "Das würde klassisch passen": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasično bi odgovaralo"
          }
