    "Kommagetrennt, auf Deutsch. Der Filter „Passt zu“ im Keller gruppiert danach." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comma-separated, in German. The “Goes with” filter in the cellar groups by it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séparés par des virgules, en allemand. Le filtre « Convient avec » dans la cave regroupe d’après cela."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
