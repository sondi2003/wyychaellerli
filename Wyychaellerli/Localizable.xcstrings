    "Wenig Aroma" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Little aroma"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peu d’arôme"
          }
        },
        "it" : {
