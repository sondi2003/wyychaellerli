    "· vorläufig, erst eine Person" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· preliminary, only one person so far"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· provisoire, une seule personne pour l’instant"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· provvisorio, finora solo una persona"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "· privremeno, tek jedna osoba"
          }
        }
      }
    },
    "„%@ – %@“ wird entfernt, auch auf den anderen Geräten." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@ – %@” will be removed, on the other devices as well."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ – %@ » sera supprimé, y compris sur les autres appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@ – %@» verrà rimosso, anche sugli altri dispositivi."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@ – %2$@“ se uklanja, i na drugim uređajima."
          }
        }
      }
    },
    "„%@“ ist jetzt leer. Was soll damit passieren?" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is now empty. What should happen to it?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est maintenant vide. Que faire ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» è ora vuoto. Che cosa ne facciamo?"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ je sada prazno. Šta treba da se uradi s njim?"
          }
        }
      }
    },
    "„%@“ liegt bereits in deinem Keller%@. Übernimmst du ihn trotzdem, steht er zweimal in der Liste." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is already in your cellar%@. If you adopt it anyway, it will be in the list twice."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est déjà dans ta cave%@. Si tu l’adoptes quand même, il figurera deux fois dans la liste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» è già nella tua cantina%@. Se lo adotti comunque, comparirà due volte nell’elenco."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ već je u tvom podrumu%2$@. Ako ga ipak preuzmeš, stajaće dvaput na listi."
          }
        }
      }
    },
    "„%@“ wird dauerhaft entfernt." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” will be removed permanently."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » sera supprimé définitivement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» verrà rimosso definitivamente."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ se trajno uklanja."
          }
        }
      }
    },
    "„%@“ wird entfernt, auch auf den anderen Geräten. Die Flaschen bleiben im Keller, sie sind danach nur nicht mehr verortet." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” will be removed, on the other devices as well. The bottles stay in the cellar, they are just no longer placed afterwards."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » sera supprimé, y compris sur les autres appareils. Les bouteilles restent dans la cave, mais ne sont plus rangées ensuite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» verrà rimosso, anche sugli altri dispositivi. Le bottiglie restano in cantina, ma poi non saranno più collocate."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ se uklanja, i na drugim uređajima. Flaše ostaju u podrumu, samo više nemaju određeno mesto."
          }
        }
      }
    },
    "„%@“ wird mit Etikett, Bewertungen und Regalplatz entfernt – auch auf den anderen Geräten. Zum Aufbewahren lieber archivieren." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” will be removed with its label, ratings and rack position – on the other devices as well. To keep it, archive it instead."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » sera supprimé avec son étiquette, ses notes et son emplacement – y compris sur les autres appareils. Pour le conserver, archive-le plutôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» verrà rimosso con etichetta, valutazioni e posizione nello scaffale, anche sugli altri dispositivi. Per conservarlo, meglio archiviarlo."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ se uklanja sa etiketom, ocenama i mestom na stalku – i na drugim uređajima. Radije arhiviraj da ga sačuvaš."
          }
        }
      }
    },
    "„Bestand erhöhen“ zählt deine Flaschen zum bestehenden Eintrag, statt einen zweiten anzulegen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Increase stock” adds your bottles to the existing entry instead of creating a second one."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Augmenter le stock » ajoute tes bouteilles à l’entrée existante au lieu d’en créer une seconde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Aumenta la giacenza» aggiunge le tue bottiglie alla voce esistente invece di crearne una seconda."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Povećaj zalihu“ dodaje tvoje flaše postojećem unosu umesto da napravi drugi."
          }
        }
      }
    },
    "„Bis“ liegt vor „Ab“ – die Angabe wird nicht verwendet." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“To” comes before “From” – the range is not used."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Jusqu’à » précède « De » – l’indication n’est pas utilisée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Fino a» precede «Da»: l’indicazione non viene usata."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Do“ je pre „Od“ – podatak se ne koristi."
          }
        }
      }
    },
