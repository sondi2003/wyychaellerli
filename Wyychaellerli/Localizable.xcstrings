          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katalog u brojkama"
          }
        }
      }
    },
    "Der Katalog ist gerade nicht erreichbar. Versuche es später nochmals." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
