    "Der Text konnte keinem Feld zugeordnet werden. Du kannst die Angaben manuell eintragen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The text could not be assigned to a field. You can enter the details manually."
