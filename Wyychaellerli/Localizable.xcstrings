            "value" : "Statistika"
          }
        }
      }
    },
    "Statt des Bestands erscheinen die archivierten Weine." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instead of the stock, the archived wines appear."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umesto zalihe prikazuju se arhivirana vina."
          }
        }
      }
    },
    "Steht bei deinen Weinbewertungen, damit beide Seiten sehen, von wem sie stammen. Den Namen kann iOS nicht selbst ermitteln, deshalb die Nachfrage." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shown with your wine ratings so both sides can see who they are from. iOS cannot find out the name by itself, hence the question."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikazuje se uz tvoje ocene vina da obe strane vide od koga potiču. iOS ne može sam da utvrdi ime, zato ovo pitanje."
          }
        }
      }
    },
    "Steht bei mehreren Regalen an jedem Fach – „%@ · B3“." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shown on every slot when there are several racks – “%@ · B3”."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod više stalaka stoji uz svako mesto – „%@ · B3“."
          }
        }
      }
    },
    "Steht im Katalog" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the catalog"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nalazi se u katalogu"
          }
        }
      }
    },
    "Steht in der Nachricht unter den Angaben – etwa wo es den Wein gibt oder was er gerade kostet." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appears in the message below the details – for example where to get the wine or what it costs right now."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoji u poruci ispod podataka – npr. gde se vino može naći ili koliko trenutno košta."
          }
        }
      }
    },
    "Steht schon im Katalog – Aufnehmen überschreibt den Eintrag mit diesen Angaben." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Already in the catalog – Accept overwrites the entry with these details."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Već je u katalogu – prihvatanje zamenjuje unos ovim podacima."
          }
        }
      }
    },
    "Steht später in der Historie. Leer lassen geht auch, dann zählt das Datum." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appears later in the history. Leaving it empty works too, then the date counts."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasnije stoji u istoriji. Može i prazno, tada važi datum."
          }
        }
      }
    },
    "Strichcode" : {
      "localizations" : {
