            "state" : "translated",
            "value" : "You are not signed in to iCloud on this device. Sign in in the system settings and try again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu n’es pas connecté à iCloud sur cet appareil. Connecte-toi dans les réglages système et réessaie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
