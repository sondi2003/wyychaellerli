        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za to nemaš dozvolu."
          }
        }
      }
    },
    "Dafür fehlt die Berechtigung. Die Rolle „Admin“ ist dieser Apple-ID in dieser Umgebung nicht zugewiesen – in der CloudKit-Konsole beim eigenen Benutzer eintragen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The permission is missing. The “Admin” role is not assigned to this Apple ID in this environment – enter it for your own user in the CloudKit console."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za to nedostaje dozvola. Uloga „Admin“ nije dodeljena ovom Apple ID-ju u ovom okruženju – upiši je u CloudKit konzoli kod sopstvenog korisnika."
          }
        }
      }
    },
    "Dahinter liegt die Rückseite mit Terroir, Ausbau und Speiseempfehlung." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behind it is the back label with terroir, aging and food pairing."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iza toga je zadnja strana sa terroirom, odležavanjem i preporukom za jela."
          }
        }
