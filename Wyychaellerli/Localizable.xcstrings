          "stringUnit" : {
            "state" : "translated",
            "value" : "Levels"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nivoi"
          }
        }
      }
    },
    "Eher nicht wieder" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rather not again"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radije ne ponovo"
          }
        }
      }
    },
    "Ein Code besteht die Prüfziffer nicht und wird nicht gespeichert." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A code fails the check digit and is not saved."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedan kod ne prolazi kontrolnu cifru i neće biti sačuvan."
          }
        }
      }
    },
    "Ein Foto aus der Mediathek nehmen oder einen Wein ganz ohne Foto erfassen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a photo from the library or add a wine without any photo."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzmi fotografiju iz biblioteke ili unesi vino sasvim bez fotografije."
          }
        }
      }
    },
    "Ein Weinkeller wurde mit dir geteilt. Verwalten kann ihn nur die Person, die ihn freigegeben hat." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A wine cellar was shared with you. Only the person who shared it can manage it."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinski podrum je podeljen sa tobom. Njime može upravljati samo osoba koja ga je podelila."
          }
        }
      }
