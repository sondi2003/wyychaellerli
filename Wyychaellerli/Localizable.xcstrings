    },
    "Zu %@ passt aus deinem Keller gerade nichts wirklich." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right now nothing in your cellar really goes with %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour %@, rien dans ta cave ne convient vraiment pour l’instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %@ al momento in cantina non c’è nulla che si abbini davvero."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uz %@ iz tvog podruma trenutno ništa zaista ne odgovara."
          }
        }
      }
    },
    "Zu diesem Gericht passt nichts aus deinem aktuellen Bestand wirklich – da bin ich lieber ehrlich." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing in your current stock really goes with this dish – I would rather be honest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien de ton stock actuel ne convient vraiment à ce plat – je préfère être honnête."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con questo piatto nulla della tua giacenza attuale si abbina davvero: preferisco essere sincero."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uz ovo jelo ništa iz tvoje trenutne zalihe zaista ne odgovara – radije sam iskren."
          }
        }
      }
    },
