    "ohne KI" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "without AI"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sans IA"
          }
        },
        "it" : {
          "stringUnit" : {
