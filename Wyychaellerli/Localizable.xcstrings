        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednostavno fotografiši celu flašu"
          }
        }
      }
    },
    "Die Freigabe hat nicht geklappt. Bitte später erneut versuchen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sharing did not work. Please try again later."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le partage n’a pas fonctionné. Réessaie plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La condivisione non è riuscita. Riprova più tardi."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deljenje nije uspelo. Pokušaj ponovo kasnije."
          }
        }
      }
    },
    "Die Freigabe ist gerade nicht möglich. Prüfe, ob du in iCloud angemeldet bist." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharing is not possible right now. Check that you are signed in to iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le partage n’est pas possible pour le moment. Vérifie que tu es connecté à iCloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La condivisione al momento non è possibile. Controlla di aver effettuato l’accesso a iCloud."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deljenje trenutno nije moguće. Proveri da li si prijavljen u iCloud."
          }
        }
      }
    },
    "Die ganze Party-Historie wird entfernt – auf allen Geräten. Der Bestand im Keller bleibt unberührt." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The whole party history will be removed – on all devices. The stock in the cellar stays untouched."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout l’historique des soirées sera supprimé – sur tous les appareils. Le stock dans la cave reste intact."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutta la cronologia delle feste verrà rimossa, su tutti i dispositivi. La giacenza in cantina resta intatta."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela istorija žurki se uklanja – na svim uređajima. Zaliha u podrumu ostaje netaknuta."
          }
        }
      }
    },
    "Die Gäste wählen, welche Flasche heute aufgeht. Das iPhone geht von Hand zu Hand." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guests choose which bottle gets opened today. The iPhone goes from hand to hand."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les invités choisissent quelle bouteille on ouvre aujourd’hui. L’iPhone passe de main en main."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli ospiti scelgono quale bottiglia aprire oggi. L’iPhone passa di mano in mano."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gosti biraju koja se flaša danas otvara. iPhone ide iz ruke u ruku."
          }
        }
      }
    },
    "Die gewählten Flaschen und die erfassten Gäste gehen verloren." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chosen bottles and the guests you added will be lost."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
