    },
    "Schliessen": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatvori"
          }
        }
      }
    },
    "Schlägt einen passenden Wein aus deinem Weinkeller zum geplanten Essen vor.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Predlaže odgovarajuće vino iz tvog vinskog podruma uz planirano jelo."
          }
        }
      }
    },
    "Schrank": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Orman"
          }
        }
      }
    },
    "Schrift läuft um die Flasche? Von links und rechts nachfotografieren.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst ide oko flaše? Fotografiši dodatno sa leve i desne strane."
          }
        }
      }
    },
    "Schweiz": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Švajcarska"
          }
        }
      }
    },
    "Schön frisch": {
      "extractionState": "manual",
      "localizations": {
