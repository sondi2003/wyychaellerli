    "Leer lassen, um die Vorgaben zu verwenden. Für Siri wird ein schnelleres Modell genutzt, weil Siri nicht lange wartet." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave empty to use the defaults. For Siri a faster model is used, because Siri does not wait long."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisse vide pour utiliser les valeurs par défaut. Pour Siri, un modèle plus rapide est utilisé, car Siri n’attend pas longtemps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia vuoto per usare i valori predefiniti. Per Siri viene usato un modello più veloce, perché Siri non aspetta a lungo."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostavi prazno za podrazumevane vrednosti. Za Siri se koristi brži model jer Siri ne čeka dugo."
          }
        }
      }
    },
    "Leere Felder füllen" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fill empty fields"
          }
        },
        "fr" : {
