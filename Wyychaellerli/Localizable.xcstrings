    "Lade eine Person mit eigener Apple-ID ein. Beide sehen denselben Bestand, auch wenn eine Flasche abgebucht wird." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invite a person with their own Apple ID. You both see the same stock, even when a bottle is taken off."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invite une personne avec son propre identifiant Apple. Vous voyez tous deux le même stock, même quand une bouteille est retirée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
