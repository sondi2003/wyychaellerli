    "Statt des Bestands erscheinen die archivierten Weine." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instead of the stock, the archived wines appear."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À la place du stock, ce sont les vins archivés qui apparaissent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al posto della giacenza compaiono i vini archiviati."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umesto zalihe prikazuju se arhivirana vina."
          }
        }
      }
    },
    "Steht bei deinen Weinbewertungen, damit beide Seiten sehen, von wem sie stammen. Den Namen kann iOS nicht selbst ermitteln, deshalb die Nachfrage." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shown with your wine ratings so both sides can see who they are from. iOS cannot find out the name by itself, hence the question."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Figure sur tes notes de vin pour que les deux côtés voient de qui elles viennent. iOS ne peut pas déterminer le nom lui-même, d’où la question."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare sulle tue valutazioni dei vini, così entrambe le parti vedono da chi provengono. iOS non può ricavare il nome da solo, da qui la domanda."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikazuje se uz tvoje ocene vina da obe strane vide od koga potiču. iOS ne može sam da utvrdi ime, zato ovo pitanje."
          }
        }
      }
    },
    "Steht bei mehreren Regalen an jedem Fach – „%@ · B3“." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shown on every slot when there are several racks – “%@ · B3”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Figure sur chaque emplacement quand il y a plusieurs casiers – « %@ · B3 »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare su ogni posto quando ci sono più scaffali: «%@ · B3»."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod više stalaka stoji uz svako mesto – „%@ · B3“."
          }
        }
      }
    },
    "Steht im Katalog" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the catalog"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans le catalogue"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nel catalogo"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nalazi se u katalogu"
          }
        }
      }
    },
    "Steht in der Nachricht unter den Angaben – etwa wo es den Wein gibt oder was er gerade kostet." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appears in the message below the details – for example where to get the wine or what it costs right now."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Figure dans le message sous les indications – par exemple où trouver le vin ou son prix actuel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare nel messaggio sotto i dati, ad esempio dove si trova il vino o quanto costa adesso."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoji u poruci ispod podataka – npr. gde se vino može naći ili koliko trenutno košta."
          }
        }
      }
    },
    "Steht schon im Katalog – Aufnehmen überschreibt den Eintrag mit diesen Angaben." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Already in the catalog – Accept overwrites the entry with these details."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjà dans le catalogue – Accepter remplace l’entrée par ces indications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Già nel catalogo: Accettare sovrascrive la voce con questi dati."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Već je u katalogu – prihvatanje zamenjuje unos ovim podacima."
          }
        }
      }
    },
    "Steht später in der Historie. Leer lassen geht auch, dann zählt das Datum." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appears later in the history. Leaving it empty works too, then the date counts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Figurera ensuite dans l’historique. Tu peux aussi laisser vide, alors la date compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparirà poi nella cronologia. Puoi anche lasciare vuoto: allora conta la data."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasnije stoji u istoriji. Može i prazno, tada važi datum."
          }
        }
      }
    },
