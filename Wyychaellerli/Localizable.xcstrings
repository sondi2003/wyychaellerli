    "Terroir, Ausbau, „Geschenk von Anna“, „bis 2030 trinken“ …" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terroir, aging, “gift from Anna”, “drink by 2030” …"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terroir, élevage, « cadeau d’Anna », « à boire jusqu’en 2030 » …"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terroir, affinamento, «regalo di Anna», «da bere entro il 2030» …"
          }
        },
        "sr-Latn" : {
