          }
        }
      }
    },
    "Ich schlage dir bis zu drei passende Weine aus deinem eigenen Keller vor – mit Begründung und Serviertipp." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suggest up to three matching wines from your own cellar – with a reason and a serving tip."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je te propose jusqu’à trois vins adaptés de ta propre cave – avec une justification et un conseil de service."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti propongo fino a tre vini adatti dalla tua cantina, con motivazione e consiglio di servizio."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predlažem ti do tri odgovarajuća vina iz tvog podruma – sa obrazloženjem i savetom za služenje."
          }
        }
      }
    },
