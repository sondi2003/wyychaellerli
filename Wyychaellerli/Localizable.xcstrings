            "value" : "Čile"
          }
        }
      }
    },
    "Dafür fehlt die Berechtigung." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The permission is missing."
          }
