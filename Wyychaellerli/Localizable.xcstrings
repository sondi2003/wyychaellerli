    "So wurde gestimmt" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How the vote went"
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovako se glasalo"
          }
        }
      }
    },
    "Sobald genug Weine im gemeinsamen Katalog liegen, siehst du hier, aus welchen Ländern sie kommen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once the shared catalog holds enough wines, you will see here which countries they come from."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čim zajednički katalog sadrži dovoljno vina, ovde ćeš videti iz kojih zemalja potiču."
          }
        }
      }
    },
    "Solange sie fehlt, kann keine Einladung angenommen werden – ein mit dir geteilter Keller bliebe unsichtbar. Meist hilft ein Neustart der App; bleibt es dabei, prüfe die iCloud-Anmeldung." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As long as it is missing, no invitation can be accepted – a cellar shared with you would stay invisible. A restart of the app usually helps; if it stays that way, check your iCloud sign-in."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dok ga nema, nijedan poziv ne može da se prihvati – podrum koji je podeljen sa tobom ostao bi nevidljiv. Obično pomaže ponovno pokretanje aplikacije; ako ostane isto, proveri prijavu u iCloud."
          }
        }
      }
    },
    "SondiNetwork" : {
