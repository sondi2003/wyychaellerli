    "Änderungen am Bestand sehen beide Seiten.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Promene zalihe vide obe strane."
          }
        }
      }
    },
    "Öffnet das Regal, um die Flaschen einzuräumen.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
