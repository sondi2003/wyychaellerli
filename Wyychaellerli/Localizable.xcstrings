    "Teilen": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Podeli"
          }
        }
      }
    },
    "Terroir, Ausbau, „Geschenk von Anna“, „bis 2030 trinken“ …": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Terroir, odležavanje, „Poklon od Ane“, „popiti do 2030“ …"
          }
        }
      }
    },
    "Text wird erkannt und zugeordnet …": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst se prepoznaje i dodeljuje …"
          }
        }
      }
    },
    "Texterkennung auf dem Gerät, Zuordnung der Felder über %@. Es wird nur der erkannte Text gesendet, nicht das Foto.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepoznavanje teksta na uređaju, dodela polja preko: %@. Šalje se samo prepoznat tekst, ne fotografija."
          }
        }
      }
    },
    "Texterkennung auf dem Gerät. Ohne API-Key werden die Felder regelbasiert zugeordnet – Jahrgang, Typ und bekannte Rebsorten klappen gut, Name und Produzent bitte prüfen.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepoznavanje teksta na uređaju. Bez API ključa polja se dodeljuju pravilima – berba, tip i poznate sorte grožđa rade dobro, naziv i proizvođača proveri."
          }
        }
      }
    },
    "Texterkennung und Zuordnung laufen komplett auf dem Gerät (Apple Intelligence).": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepoznavanje teksta i dodela rade u potpunosti na uređaju (Apple Intelligence)."
          }
        }
      }
    },
    "Thai-Curry": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tajlandski kari"
          }
        }
      }
    },
    "Tippe auf das Fach, aus dem du die Flasche nimmst. Der Bestand geht um eins runter und das Fach wird frei.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni mesto iz kog vadiš flašu. Zaliha se smanjuje za jedan i mesto se oslobađa."
          }
        }
      }
    },
    "Tippe auf die Sterne": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni zvezdice"
          }
        }
      }
    },
    "Tippe auf eine Seite, um sie mit der Kamera zu erfassen. Fotografiere die Flasche einfach ganz – die App sucht die Etikettenkante selbst, schneidet zu und begradigt. Kein Ausrichten nötig.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni stranu da je snimiš kamerom. Jednostavno fotografiši celu flašu – aplikacija sama traži ivicu etikete, iseca je i ispravlja. Nije potrebno poravnavanje."
          }
        }
      }
    },
    "Tippe auf einen Wein in dieser Liste und wisch dann über die freien Fächer – so viele, wie er Flaschen hat.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni vino na ovoj listi, pa prevuci preko slobodnih mesta – onoliko koliko ima flaša."
          }
        }
      }
    },
    "Tippe auf einen Wein und wähle dann so viele Fächer, wie er Flaschen hat – nebeneinander oder verteilt. Oder tippe auf ein freies Fach für eine einzelne Flasche.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni vino, pa izaberi onoliko mesta koliko ima flaša – jedno do drugog ili razmaknuto. Ili dodirni slobodno mesto za jednu flašu."
          }
        }
      }
    },
    "Tippe oben rechts auf + und fotografiere die Flasche, wie sie steht. Die App findet das Etikett selbst, liest Name, Jahrgang, Rebsorte und Region und füllt alles vor. Fotografierst du auch die Rückseite, kommen die Notizen gleich mit.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni + gore desno i fotografiši flašu onako kako stoji. Aplikacija sama pronalazi etiketu, čita naziv, berbu, sortu i region i sve unapred popunjava. Ako fotografišeš i zadnju stranu, stižu i beleške."
          }
        }
      }
    },
    "Tippen zum Scannen": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni za skeniranje"
          }
        }
      }
    },
    "Tipps nochmals zeigen": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovo prikaži savete"
          }
        }
      }
    },
    "Tipps werden wieder gezeigt": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Saveti se ponovo prikazuju"
          }
        }
      }
    },
    "Touch ID": {
      "extractionState": "manual"
    },
    "Trage in den Einstellungen deinen Namen ein, damit man sieht, von wem die Bewertung stammt.": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Upiši svoje ime u podešavanjima da bi se videlo od koga je ocena."
          }
        }
      }
    },
    "Trinken": {
      "extractionState": "manual",
      "localizations": {
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
