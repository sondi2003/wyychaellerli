    "Zum Löschen nach links wischen. Die Historie gehört zum Keller – was du hier entfernst, verschwindet auch auf den anderen Geräten." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe left to delete. The history belongs to the cellar – what you remove here disappears on the other devices as well."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balaie vers la gauche pour supprimer. L’historique appartient à la cave – ce que tu retires ici disparaît aussi sur les autres appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri verso sinistra per eliminare. La cronologia appartiene alla cantina: ciò che rimuovi qui scompare anche sugli altri dispositivi."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za brisanje prevuci ulevo. Istorija pripada podrumu – ono što ovde ukloniš nestaje i na drugim uređajima."
          }
        }
      }
    },
