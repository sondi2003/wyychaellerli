    "Über den Entscheid kommt eine Mitteilung, sofern du sie erlaubt hast." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You get a notification about the decision, if you have allowed them."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu reçois une notification sur la décision, si tu les as autorisées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi una notifica sulla decisione, se le hai consentite."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O odluci stiže obaveštenje, ako si ga dozvolio."
          }
        }
      }
    },
    "Übernehmen" : {
      "extractionState" : "manual",
