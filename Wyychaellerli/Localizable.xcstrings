    "Mindestens zwei Flaschen, sonst gibt es nichts zu wählen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At least two bottles, otherwise there is nothing to choose."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au moins deux bouteilles, sinon il n’y a rien à choisir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almeno due bottiglie, altrimenti non c’è nulla da scegliere."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najmanje dve flaše, inače nema šta da se bira."
          }
        }
      }
    },
    "Mit diesen Angaben steht schon „%@“ im Katalog. Ändere Name, Produzent oder Jahrgang, oder lösche einen der beiden Einträge." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is already in the catalog with these details. Change the name, producer or vintage, or delete one of the two entries."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec ces indications, « %@ » figure déjà dans le catalogue. Modifie le nom, le producteur ou le millésime, ou supprime l’une des deux entrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con questi dati «%@» è già nel catalogo. Cambia nome, produttore o annata, oppure elimina una delle due voci."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa ovim podacima „%@“ je već u katalogu. Promeni naziv, proizvođača ili berbu, ili obriši jedan od dva unosa."
          }
        }
      }
    },
