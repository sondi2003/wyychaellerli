    "Das Ergebnis wird in der Historie gesichert. Danach kannst du die Flasche wie gewohnt öffnen – die App zeigt dir das Regalfach." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The result is saved in the history. Then you can open the bottle as usual – the app shows you the rack slot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le résultat est enregistré dans l’historique. Ensuite tu peux ouvrir la bouteille comme d’habitude – l’app te montre l’emplacement dans le casier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il risultato viene salvato nella cronologia. Poi puoi aprire la bottiglia come al solito: l’app ti mostra il posto nello scaffale."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rezultat se čuva u istoriji. Zatim flašu možeš otvoriti kao i obično – aplikacija ti pokazuje mesto na stalku."
          }
        }
      }
