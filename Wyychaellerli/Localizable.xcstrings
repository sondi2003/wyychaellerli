    "Wisch über die freien Fächer oder tippe sie an. Mehr als du Flaschen hast, lässt sich nicht auswählen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe across the free slots or tap them. You cannot select more than you have bottles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balaie les emplacements libres ou touche-les. Tu ne peux pas en sélectionner plus que tu n’as de bouteilles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri sui posti liberi o toccali. Non puoi selezionarne più di quante bottiglie hai."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevuci preko slobodnih mesta ili ih dodirni. Ne može se izabrati više mesta nego što imaš flaša."
          }
        }
      }
    },
