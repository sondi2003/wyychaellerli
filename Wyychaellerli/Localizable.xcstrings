    "Nach den Speiseempfehlungen der Weine, ersatzweise des Katalogs. Weine ohne Empfehlung erscheinen hier nicht." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Based on each wine's food pairings, or the catalog's if it has none. Wines without a pairing are not listed here."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’après les recommandations de plats des vins, à défaut celles du catalogue. Les vins sans recommandation n’apparaissent pas ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In base agli abbinamenti dei vini o, in mancanza, a quelli del catalogo. I vini senza abbinamento non compaiono qui."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prema preporukama za jelo uz vina, a ako ih nema, prema katalogu. Vina bez preporuke nisu ovde navedena."
          }
        }
      }
    },
