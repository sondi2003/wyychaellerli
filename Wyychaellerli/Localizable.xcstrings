          "stringUnit" : {
            "state" : "translated",
            "value" : "No need to line it up: the app finds the label itself and crops it. Add the back label too, and the notes come along."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije potrebno poravnavanje: aplikacija sama pronalazi etiketu i iseca je. Dodaj i zadnju stranu, pa stižu i beleške."
