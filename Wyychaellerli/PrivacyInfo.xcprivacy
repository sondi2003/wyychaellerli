<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Kein Tracking, keine Werbe-IDs, keine Analyse-SDKs. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Gesammelt wird nur, was ein Nutzer ausdrücklich für den gemeinsamen Katalog
	     vorschlägt (Stammdaten des Weins und das Foto der Vorderseite). CloudKit hängt
	     an jeden Vorschlag die Kennung des Erstellers – pseudonym, aber eine Kennung,
	     deshalb „verknüpft“. Was an einen KI-Anbieter geht, läuft über den Schlüssel des
	     Nutzers an dessen eigenes Konto und ist hier nicht erfasst; das entscheidet der
	     Entwickler in App Store Connect. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<!-- Apple verlangt seit 2024 einen Grund für bestimmte Schnittstellen.
	     Genutzt wird nur UserDefaults, und zwar ausschliesslich für eigene
	     Einstellungen dieser App (Erscheinungsbild, Anzeigename, Modellnamen). -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
